<Window x:Class="XiaoGouYingYu.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入预览" Height="560" Width="720" WindowStartupLocation="CenterOwner" Background="#FFFDF8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="导入预览" FontSize="24" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#F5EFE2" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding SummaryLine}" FontSize="18"/>
                <TextBlock Text="{Binding EncodingLine}" FontSize="16" Foreground="#C0392B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  FontSize="16" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="50"/>
                <DataGridTextColumn Header="英文" Binding="{Binding English}" Width="220"/>
                <DataGridTextColumn Header="中文" Binding="{Binding Chinese}" Width="220"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <CheckBox Grid.Row="3" Content="覆盖同名年级词库（不勾则取消导入）" IsChecked="{Binding Overwrite}"
                  FontSize="18" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="按 GBK 转码后重试" Width="200" Height="44" FontSize="18" Click="Transcode_Click"/>
            <Button Content="取消" Width="100" Height="44" FontSize="18" Margin="10,0,0,0" Click="Cancel_Click"/>
            <Button Content="确认入库" Width="140" Height="44" FontSize="18" Margin="10,0,0,0"
                    Click="Confirm_Click" Background="#2E9E6B" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
