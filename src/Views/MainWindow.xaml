<Window x:Class="XiaoGouYingYu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小狗英语" Height="720" Width="1024" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#FFFDF8">

    <Grid x:Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>   <!-- 模式切换 -->
            <RowDefinition Height="Auto"/>   <!-- 筛选 -->
            <RowDefinition Height="Auto"/>   <!-- 辅助控制条：慢速 + 查词 -->
            <RowDefinition Height="*"/>      <!-- 卡片 -->
            <RowDefinition Height="Auto"/>   <!-- 输入/反馈 -->
            <RowDefinition Height="Auto"/>   <!-- 导航按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="小狗英语" FontSize="26" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" FontSize="18" Foreground="#666" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <Button Content="更多" HorizontalAlignment="Right" Width="90" Height="42" FontSize="18"
                    Click="MoreButton_Click" Background="#8E6CE6" Foreground="White"/>
        </DockPanel>

        <!-- 模式切换（4 个按钮固定在卡片顶部） -->
        <StackPanel x:Name="ModeButtonStack" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="整体读音" Width="130" Height="46" FontSize="18" Margin="0,0,8,0"
                    Command="{Binding SetModeCommand}" CommandParameter="0" Click="ModeButton_Click" Tag="0"/>
            <Button Content="拼读" Width="110" Height="46" FontSize="18" Margin="0,0,8,0"
                    Command="{Binding SetModeCommand}" CommandParameter="1" Click="ModeButton_Click" Tag="1"/>
            <Button Content="看中文背英文" Width="170" Height="46" FontSize="18" Margin="0,0,8,0"
                    Command="{Binding SetModeCommand}" CommandParameter="2" Click="ModeButton_Click" Tag="2"/>
            <Button Content="看中文+听音默写" Width="210" Height="46" FontSize="18"
                    Command="{Binding SetModeCommand}" CommandParameter="3" Click="ModeButton_Click" Tag="3"/>
        </StackPanel>

        <!-- 年级 / 单元筛选 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="年级" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding GradeNames}" SelectedItem="{Binding SelectedGrade}"
                      Width="160" Height="40" FontSize="18"/>
            <TextBlock Text="单元" FontSize="18" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox ItemsSource="{Binding UnitNames}" SelectedItem="{Binding SelectedUnit}"
                      Width="140" Height="40" FontSize="18"/>
            <CheckBox Content="乱序" IsChecked="{Binding Shuffle}" FontSize="18" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- 辅助控制条：慢速开关（与查词并列，人人可用） + 查词 -->
        <StackPanel x:Name="SpeedPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="正常" Width="80" Height="40" FontSize="18" Click="NormalSpeed_Click" Tag="normal"/>
            <Button Content="慢速" Width="80" Height="40" FontSize="18" Margin="6,0,0,0" Click="SlowSpeed_Click" Tag="slow"/>
            <Button Content="🔍 查词" Width="120" Height="40" FontSize="18" Margin="20,0,0,0"
                    Command="{Binding LookupCommand}" Background="#5BA8E8" Foreground="White"/>
        </StackPanel>

        <!-- 卡片 -->
        <Border Grid.Row="4" Background="White" CornerRadius="16" Padding="24"
                BorderBrush="#E8E0D0" BorderThickness="2">
            <Grid>
                <!-- 一轮收口小结 -->
                <StackPanel Visibility="{Binding ShowRoundSummary, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="这一轮完成啦！" FontSize="32" FontWeight="Bold" Foreground="#E67E22"/>
                    <TextBlock Text="{Binding RoundSummaryText}" FontSize="22" Margin="0,20,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="再练一轮" Width="140" Height="48" FontSize="18" Click="RestartRound_Click"/>
                        <Button Content="只练待复习" Width="160" Height="48" FontSize="18" Margin="10,0,0,0" Click="ReviewOnly_Click"/>
                        <Button Content="返回" Width="100" Height="48" FontSize="18" Margin="10,0,0,0" Click="Return_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 正常卡片 -->
                <StackPanel Visibility="{Binding ShowRoundSummary, Converter={StaticResource InverseBoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 中文（所有模式都显示） -->
                    <TextBlock Text="{Binding CardChinese}" FontSize="40" FontWeight="Bold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="800"/>

                    <!-- 英文（仅非输入模式显示；默写/看中文背英文时 CardEnglish 为空） -->
                    <TextBlock Text="{Binding CardEnglish}" FontSize="44" Foreground="#2C3E50"
                               HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>

                    <!-- 音节/逐词切分（拼读模式高亮当前段，其他模式普通显示） -->
                    <ItemsControl x:Name="SegmentItems" ItemsSource="{Binding SegmentList}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                  Visibility="{Binding IsAnswerMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10,4" Margin="4,0" Background="#F0E6D2">
                                    <TextBlock Text="{Binding}" FontSize="26" Foreground="#8A6D3B"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 输入区（输入模式） -->
                    <StackPanel Visibility="{Binding IsAnswerMode, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,20,0,0" HorizontalAlignment="Center">
                        <TextBox x:Name="AnswerBox" Width="520" Height="52" FontSize="26"
                                 Text="{Binding AnswerInput, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="AnswerBox_KeyDown" GotFocus="AnswerBox_GotFocus"/>
                        <Button Content="确定" Width="140" Height="46" FontSize="18" Margin="0,12,0,0"
                                Command="{Binding SubmitAnswerCommand}" Background="#2E9E6B" Foreground="White"/>
                    </StackPanel>

                    <!--  Hint（孩子能读懂的短句） -->
                    <TextBlock Text="{Binding Hint}" FontSize="20" Foreground="#C0392B"
                               HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 播放按钮 + 反馈 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,10">
            <Button Content="▶ 播放" Width="140" Height="52" FontSize="20" Command="{Binding PlayCommand}"
                    Background="#E67E22" Foreground="White"/>
        </StackPanel>

        <!-- 导航按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="上一张" Width="120" Height="46" FontSize="18" Command="{Binding PrevCommand}"/>
            <Button Content="跳过" Width="100" Height="46" FontSize="18" Margin="10,0,0,0" Command="{Binding SkipCommand}"/>
            <Button Content="下一张" Width="120" Height="46" FontSize="18" Margin="10,0,0,0" Command="{Binding NextCommand}"/>
            <Button Content="标记掌握" Width="140" Height="46" FontSize="18" Margin="24,0,0,0"
                    Command="{Binding MarkMasteredCommand}" Background="#2E9E6B" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
