<Window x:Class="XiaoGouYingYu.MoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更多" Height="600" Width="760" WindowStartupLocation="CenterOwner"
        Background="#FFFDF8" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="更多" FontSize="26" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,14"/>

            <!-- 版本与数据核对 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="版本与数据" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding VersionLine}" FontSize="18" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding DataCounts}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock Text="升级后请核对：词库条数、进度条数、待补充音节数。" FontSize="16" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 朗读声音 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="朗读声音" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding Voices}" DisplayMemberPath="Display"
                                  SelectedValuePath="Name" SelectedValue="{Binding SelectedVoiceName}"
                                  Width="360" Height="40" FontSize="18"/>
                        <Button Content="刷新声音列表" Width="160" Height="40" FontSize="18" Margin="12,0,0,0"
                                Click="RefreshVoices_Click"/>
                    </StackPanel>
                    <TextBlock Text="装了新语音包可点刷新；神经语音优先。安装自然语音见「家长说明」按钮。" FontSize="16" Foreground="#666" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 学习统计 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="学习统计" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatCounts}" FontSize="18" Margin="0,6,0,0"/>
                    <TextBlock Text="按当前筛选范围统计，口径与练习小结一致。" FontSize="16" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 词库操作 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="词库" FontSize="20" FontWeight="Bold"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="导入词库" Width="140" Height="42" FontSize="18" Margin="0,0,10,10" Click="Import_Click"/>
                        <Button Content="词库管理" Width="140" Height="42" FontSize="18" Margin="0,0,10,10" Click="Manage_Click"/>
                        <Button Content="导出词库" Width="140" Height="42" FontSize="18" Margin="0,0,10,10" Click="Export_Click"/>
                        <Button Content="恢复内置词库" Width="170" Height="42" FontSize="18" Margin="0,0,10,10" Click="RestoreBuiltin_Click"/>
                    </WrapPanel>
                    <TextBlock Text="导出词库：仅词库文字，不含进度/修正/设置。备份下方：含全部数据。" FontSize="15" Foreground="#666"/>
                </StackPanel>
            </Border>

            <!-- 备份 / 还原 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="备份与还原" FontSize="20" FontWeight="Bold"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="备份全部数据" Width="170" Height="42" FontSize="18" Margin="0,0,10,10" Click="Backup_Click"/>
                        <Button Content="从备份还原" Width="150" Height="42" FontSize="18" Margin="0,0,10,10" Click="Restore_Click"/>
                        <Button Content="清理已删除记录" Width="170" Height="42" FontSize="18" Margin="0,0,10,10" Click="ClearRetired_Click"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding BackupPath}" FontSize="15" Foreground="#2E7D32" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 待补充音节清单 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="待补充音节" FontSize="20" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding PendingLines}" Height="120" FontSize="16"/>
                    <TextBlock Text="在这里集中查看后可到「词库管理」修正音节。" FontSize="15" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 查词模板 + 说明 -->
            <Border Background="#F5EFE2" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="查词网站" FontSize="20" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding LookupTemplates}" DisplayMemberPath="Name"
                              SelectedValuePath="Template" SelectedValue="{Binding LookupTemplate}"
                              Width="420" Height="40" FontSize="18" Margin="0,8,0,0"/>
                    <TextBlock Text="以网站实际页面为准。" FontSize="15" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="家长说明（安装自然语音 / 覆盖更新）" Width="360" Height="44" FontSize="18"
                    HorizontalAlignment="Left" Click="ParentGuide_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
