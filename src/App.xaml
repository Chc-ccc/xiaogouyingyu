<Application x:Class="XiaoGouYingYu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XiaoGouYingYu.Converters">
    <Application.Resources>
        <!-- 全局字体：面向 8 岁孩子，界面基础字号不小于 18px -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="19"/>
        </Style>
        <conv:BoolToVisibility x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibility x:Key="InverseBoolToVisibility"/>
    </Application.Resources>
</Application>
